# ==============================================================================
# Learnova AI - Environment Configuration Example
# Copy this file to .env and adjust values for your local development or deployment
# ==============================================================================

# Application Metadata
APP_ENV=development
APP_NAME="Learnova AI"
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# Service Ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
AI_SERVICE_PORT=8001
ML_SERVICE_PORT=8002

# Service Hosts & URLs (Internal & Local)
BACKEND_HOST=0.0.0.0
AI_SERVICE_HOST=0.0.0.0
ML_SERVICE_HOST=0.0.0.0

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AI_SERVICE_URL=http://localhost:8001/api/v1
VITE_ML_SERVICE_URL=http://localhost:8002/api/v1

# Security & CORS
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Authentication & JWT Security
JWT_SECRET_KEY=learnova-ai-insecure-dev-secret-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Database Configuration (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=learnova_db

# Async Database Connection String (SQLAlchemy asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learnova_db
# Sync Database Connection String (used by Alembic migrations if needed)
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/learnova_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# AI Service & RAG Configuration (Phase 7)
AI_SERVICE_NAME=learnova-ai-service
AI_SERVICE_URL=http://localhost:8001/api/v1
LLM_PROVIDER=mock
LLM_MODEL=learnova-tutor-mock-v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.10

# ML Service Configuration (Phase 8 Placeholder)
ML_SERVICE_NAME=learnova-ml-service
MLFLOW_TRACKING_URI=
MODEL_REGISTRY_PATH=./ml-service/app/models/registry
