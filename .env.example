# ==============================================================================
# ExcelR Learnova — Learning & Progress Platform
# Environment Configuration Template
# Copy this file to .env and adjust values for your local development or deployment
# ==============================================================================

# Application Metadata
APP_ENV=development
APP_NAME="ExcelR Learnova"
APP_SUBTITLE="Learning & Progress Platform"
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Service Bindings
FRONTEND_PORT=5173
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Authentication & JWT Security
JWT_SECRET_KEY=excelr-learnova-dev-secret-key-replace-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Database Configuration (PostgreSQL / SQLite for local development)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=learnova_db

# Async Database Connection String (SQLAlchemy SQLite for quick local execution)
DATABASE_URL=sqlite+aiosqlite:///./learnova_local.db
DATABASE_SYNC_URL=sqlite:///./learnova_local.db

# Redis Configuration (Optional in local development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# ExcelR Track360 Authoritative Operational Integration
# ==============================================================================
TRACK360_BASE_URL=http://localhost:8000
TRACK360_SERVICE_EMAIL=admin@excelr.com
TRACK360_SERVICE_PASSWORD=Admin@Track360_2026!
TRACK360_TIMEOUT_SECONDS=5.0
TRACK360_MOCK_FALLBACK=true
